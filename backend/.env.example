# Application Settings
APP_NAME=Pramana-Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a unique value for each environment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
# 1. When running PostgreSQL in Docker and Backend locally:
#    DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/pramana_db
# 2. When running both inside Docker Compose:
#    DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@db:5432/pramana_db
# 3. When connecting to AWS RDS:
#    DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/pramana_db
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/pramana_db

# AWS Configuration (Coordinated with Person 3)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=pramana-kyc-documents-bucket
SES_SENDER_EMAIL=noreply@pramana.example.com

# Verification Engine Thresholds
SIMILARITY_THRESHOLD_NAME=85.0
SIMILARITY_THRESHOLD_ADDRESS=80.0
